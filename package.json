{
  "name": "@alphapay/node",
  "version": "0.1.0",
  "description": "Official Node.js / TypeScript SDK for the AlphaPay payment aggregator API.",
  "license": "MIT",
  "homepage": "https://github.com/AlphaConnect-Technology/AlphaPaySDK-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlphaConnect-Technology/AlphaPaySDK-node.git"
  },
  "bugs": {
    "url": "https://github.com/AlphaConnect-Technology/AlphaPaySDK-node/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist-test/**/*.test.js",
    "pretest": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
